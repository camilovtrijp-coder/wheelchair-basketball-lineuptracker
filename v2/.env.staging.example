# Voorbeeldbestand voor de staging-context.
#
# Firebase-webconfig-waarden (projectId, apiKey, authDomain) zijn publieke
# projectidentificatie, geen geheimen (zie AGENTS.md, "Firebase-webconfig is
# publieke projectidentificatie en geen autorisatiegeheim"). Toch horen ze
# niet in Git: ze zijn per deploycontext anders en worden pas ingevuld zodra
# het staging-Firebase-project daadwerkelijk bestaat (PR 5.5b).
#
# Kopieer dit bestand naar .env.staging (genegeerd door Git) en vul de echte
# waarden in zodra ze bekend zijn.
VITE_DEPLOY_CONTEXT=staging
VITE_FIREBASE_PROJECT_ID_STAGING=wheelchair-basketball-tracker
VITE_FIREBASE_API_KEY_STAGING=vervang-met-echte-staging-apikey
VITE_FIREBASE_AUTH_DOMAIN_STAGING=wheelchair-basketball-tracker.firebaseapp.com

# PR 8.3a: monitor-only App Check. Laat false totdat de eigenaar de
# reCAPTCHA Enterprise-datastroom heeft goedgekeurd en de staging-sitekey is
# geregistreerd. Dit schakelt GEEN Firebase-console-enforcement in.
VITE_FIREBASE_APP_CHECK_ENABLED_STAGING=false
VITE_FIREBASE_APP_CHECK_RECAPTCHA_ENTERPRISE_KEY_STAGING=vervang-met-echte-staging-sitekey
