{
  "name": "lineup-tracker-v2",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Lineup Tracker v2 — Preact + TypeScript + Vite scaffold (fase 3, PR 3.1)",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier -w .",
    "format:check": "prettier -c .",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:auth": "playwright test --config=playwright.auth.config.ts",
    "test:e2e:install": "playwright install chromium",
    "preview:e2e": "vite preview --port 4173 --strictPort"
  },
  "dependencies": {
    "firebase": "^12.17.1",
    "firebase-base": "*"
  },
  "devDependencies": {
    "@eslint/js": "^9.10.0",
    "@playwright/test": "^1.62.1",
    "@preact/preset-vite": "^2.9.1",
    "@types/node": "^20.16.5",
    "eslint": "^9.10.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "firebase-admin": "^14.2.0",
    "globals": "^15.9.0",
    "preact": "^10.24.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.5.0",
    "vite": "^5.4.6",
    "vite-plugin-pwa": "^0.21.2",
    "vitest": "^2.1.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1"
  }
}
