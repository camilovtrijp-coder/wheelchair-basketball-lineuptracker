{
  "name": "lineup-tracker-v2",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Lineup Tracker v2 — Preact + TypeScript + Vite scaffold (fase 3, PR 3.1)",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier -w .",
    "format:check": "prettier -c .",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^9.10.0",
    "@preact/preset-vite": "^2.9.1",
    "@types/node": "^20.16.5",
    "eslint": "^9.10.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.9.0",
    "preact": "^10.24.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.5.0",
    "vite": "^5.4.6",
    "vitest": "^2.1.1"
  }
}
