# Voorbeeldbestand voor de development-context.
#
# Development gebruikt vaste defaults uit
# v2/src/infrastructure/firebase/webConfig.ts (het emulatorproject
# demo-lineup-tracker-dev) en heeft dus GEEN env-variabelen nodig — dit
# bestand dient puur ter documentatie van wat er zou gelden.
#
# Kopieer dit nooit als .env.development met echte productie- of
# staging-waarden naar Git.
VITE_DEPLOY_CONTEXT=development
