rules_version = '2';

// PR 5.1 — reproduceerbare Firebase-basis. Vervolg op de begrensde spike (PR 4.4,
// zie firebase-spike/). Implementeert ADR-003's Rules-only-uitnodigingsflow en
// organisatie-/team-/rolgebonden autorisatie voor settings/roster (fase-4/5-scope).
//
// PR 7.1b voegt games/{gameId}(/actions/{actionId}) toe (docs/pr-7.1-plan.md §C
// 7.1b). Seasons-paden bestaan nog niet en blijven default-deny.
//
// Expliciete ontwerpkeuzes, overgenomen uit de spike (zie firebase-spike/docs/SPIKE_REPORT.md):
//  1. rolopslag: organizationMembers/{uid}.role is bron van waarheid op org-niveau;
//     teamMembers/{uid}.role is een gedenormaliseerde kopie — voorkomt extra get() per team-rule.
//  2. organizationOwner/organizationAdmin krijgen impliciet toegang tot alle teams zonder
//     een los teamMembers-document; coach/scorer/viewer hebben een expliciet teamMembers-doc nodig.
//  3. Bootstrap van eerste organisatie: organizations.createdBy + een Rules-get()-check.
//
// Nieuw in PR 5.1 — oplossing voor issue #28 (querycontract contextwisselaar):
//  4. organizationMembers/{uid} draagt nu ook een `uid`-veld (gelijk aan de document-ID).
//     Onderaan staat een APARTE, recursieve-wildcard match
//     (`match /{path=**}/organizationMembers/{uid}`) die uitsluitend
//     `resource.data.uid == request.auth.uid` toestaat. Empirisch bleek dit
//     nodig te zijn: de bestaande geneste match
//     (`organizations/{orgId}/organizationMembers/{uid}`) governeert directe
//     GET's/writes prima, maar een `collectionGroup`-LIST-query tegen die
//     geneste match gaf altijd "No matching allow statements" — ook met een
//     triviale, puur resource.data-gebaseerde voorwaarde en zonder enige
//     get()/exists() in de expressie. Firestore lijkt collectionGroup-queries
//     alleen te autoriseren via een `{path=**}`-recursieve match, niet via een
//     vaste geneste match, ongeacht de complexiteit van de voorwaarde zelf.
//     Zie firebase/docs/QUERY_CONTRACT.md voor het volledige, empirisch
//     beproefde contract.
//  5. [P1, review-opvolging] De owner/admin-update-regels voor organizationMembers
//     eisen nu expliciet dat `uid` ongewijzigd blijft (`request.resource.data.uid
//     == uid == resource.data.uid`). Zonder deze eis kon een update het
//     querybepalende `uid`-veld laten afwijken van de document-ID, waardoor de
//     recursieve collectionGroup-regel in punt 4 een membership aan de verkeerde
//     gebruiker had kunnen tonen (of de echte eigenaar het liet "verdwijnen" uit
//     diens eigen contextwisselaar-query). Zie
//     tests/rules/self-promotion.spec.ts voor de bewijzende negatieve tests.
//
// Nieuw in PR 5.2 — oplossing voor issue #31 (team-only leden onzichtbaar in de
// contextwisselaar):
//  6. teamMembers/{uid} draagt nu ook een `uid`-veld, exact hetzelfde patroon als
//     organizationMembers/{uid} voor issue #28: verplicht bij create, onveranderlijk
//     bij update, en een aparte recursieve-wildcard match onderaan voor de collection-
//     group-LIST-query "alle teams waar ik lid van ben" — nodig voor gebruikers met
//     uitsluitend een teamMembers-document (geen organizationMembers), die anders
//     via geen enkele query hun eigen team-only toegang konden vinden.
//  7. teams/{teamId} draagt nu ook een `orgName`-veld (denormalisatie van de
//     organisatienaam). Een team-only lid mag `organizations/{orgId}` zelf niet lezen
//     (die leesregel blijft bewust `isOrgMember(orgId)`, NIET verbreed naar alle
//     ingelogde gebruikers) maar heeft via `canReadTeam` wél directe leestoegang tot
//     het teamdocument — zonder deze denormalisatie zou de contextwisselaar voor
//     zo'n gebruiker geen organisatienaam kunnen tonen.
//
// Nieuw in PR 7.1b — games/{gameId}(/actions/{actionId}) (docs/pr-7.1-plan.md §C 7.1b):
//  8. `canWriteGameData` is een eigen, ruimere bevoegdheid dan `canManageTeamData`:
//     owner/admin/coach/scorer mogen wedstrijddata schrijven (spiegelt exact
//     `v2/src/domain/organizations/teamAccess.ts` `deriveTeamAccess().canWriteGameData`
//     — coach/scorer mogen scoren/wisselen zonder settings/roster te mogen beheren);
//     viewer blijft overal read-only via `canReadTeam`.
//  9. Game-create eist overeenkomende pad-/payloadcontext (`organizationId`/`teamId`),
//     `phase in ['setup','tracking']`, `revision == 0` en dat een eventuele initiële
//     `writerUid` (ADR-002's epoch/fencing-contract, punt 3) niet op een ANDERE
//     gebruiker dan de maker gezet kan worden — "maker" is hier dus geborgd via het
//     writer-veld zelf, er is geen apart `createdBy`-veld op `GameDocument`.
//     [Tweede review-opvolging, P1] `writerUid`/`deviceId` moeten SAMEN "beide
//     null" of "beide gezet, deviceId non-empty" zijn — een document met
//     `writerUid` al gezet maar `deviceId == null` kan daarna geen enkele
//     action meer accepteren en ook niet via het initiële-claim-pad hersteld
//     worden (dat vereist juist `writerUid == null`).
//  10. Game-update is gesplitst in twee expliciete paden, elk met een strikte
//      veldallowlist (identiteits-/historische kernvelden —
//      `organizationId`/`teamId`/`players`/`opponent`/`competition`/`clockDown`/
//      `limitStr`/`createdAt` — zijn in GEEN van beide paden wijzigbaar):
//        a. **normale patch door de huidige writer**: alleen draaivelden,
//           afgeleide snapshot en `revision` mogen wijzigen; `writerUid`/
//           `deviceId`/`writerEpoch` moeten EXACT gelijk blijven (geen
//           claim/overname via dit pad) en de aanroeper moet zelf de actuele
//           `writerUid` zijn — een andere bevoegde gebruiker (bijv. een
//           andere coach) mag hier niet via patchen;
//        b. **initiële claim**: alleen toegestaan als het document nog geen
//           writer heeft (`resource.data.writerUid == null`); de aanroeper
//           claimt uitsluitend zichzelf (`writerUid == request.auth.uid`),
//           `writerEpoch` blijft ongewijzigd (geen sprong).
//      Een latere OVERNAME (bestaande writer vervangen) heeft geen eigen pad
//      hier — dat is bewust PR 7.3-scope (transactioneel, met epoch-increment)
//      en blijft tot die tijd geweigerd: `writerUid`/`deviceId`/`writerEpoch`
//      zijn dus effectief immutable zodra eenmaal geclaimd. `phase` mag in
//      beide paden alleen gelijk blijven of van `'setup'` naar `'tracking'`
//      (nooit terug/overslaan); `revision` moet exact met 1 omhoog — dit is
//      tevens de optimistische-concurrencycontrole voor snapshotpatches uit
//      PR 7.1c: een niet-transactionele write op een verouderde `revision`
//      wordt door Rules geweigerd, geen aparte transactie nodig.
//  11. Action-create is create-only (geen update/delete, ADR-002 punt 1): eigen
//      auteur (`authorUid == request.auth.uid`), overeenkomende pad-/payloadcontext,
//      en `writerEpoch`/`deviceId` moeten overeenkomen met de ACTUELE waarden op het
//      parentdocument, geschreven door de daadwerkelijke huidige `writerUid`. Een
//      actie uit een oude/overgenomen epoch (na een toekomstige PR 7.3-overname)
//      wordt hierdoor al geweigerd, ook al is de overnamelogica zelf pas 7.3-scope.
//  12. Geen recursieve-wildcard match voor `games`/`actions` (in tegenstelling tot
//      punt 4/6 hierboven): er is nog geen cross-team queerybehoefte, dus elke
//      `collectionGroup`-query op `games`/`actions` blijft default-deny — zie
//      `firebase/docs/QUERY_CONTRACT.md` §"Wedstrijd-/actiepaden".
//  13. [P1, review-opvolging] Rules valideerden aanvankelijk slechts enkele
//      context-/writervelden, niet de volledige sleutelset/veldtypen — een
//      document zonder verplichte velden (bijv. `updatedAt`) of met een extra,
//      onbekend veld werd geaccepteerd, ook al kon de PR 7.1a-converter zo'n
//      document daarna niet meer lezen. `isValidGamePayload()`/
//      `isValidActionEnvelope()` eisen nu de EXACTE sleutelset (`hasAll` +
//      `hasOnly`, geen ontbrekende én geen extra velden) plus het juiste
//      Firestore-Rules-type per veld, voor zowel create als de resulterende
//      documentstaat na elke update. `isValidActionPayload()` valideert de
//      discriminated union van `action.type` inclusief de exacte sleutelset
//      per actietype (`score-delta`/`score-set`/`segment-saved`/
//      `segment-edited`/`segment-deleted`) en `schemaVersion == 1`.
//      `createdAt`/`startedAt`/`occurredAt` worden tegen een ISO-8601-
//      vormregel (`matches()`) gecontroleerd — Rules kunnen, in tegenstelling
//      tot de converter, geen kalenderlogica narekenen (bijv. 31 februari),
//      dus dat blijft de converter-laag's taak; hier gaat het om de vorm.
//      `segment` (in `segment-saved`/`segment-edited`) wordt volledig
//      gevalideerd via `isValidSegment()` — Segment heeft een vast, klein
//      aantal top-level velden, dus dat ís zonder lus volledig te
//      controleren (exacte sleutelset + veldtype per veld). `players`
//      (list van objecten) en `onCourt`/`pendingSwapLineup`/`segment.lineup`
//      (list van strings) blijven wél alleen op `list`-type gecontroleerd:
//      Rules hebben geen lus-/`.all()`-constructie om een list element-voor-
//      element te valideren — een bewuste, gedocumenteerde taalgrens. Dat
//      residuele gat wordt beperkt doordat schrijftoegang al tot
//      `canWriteGameData`-rollen beperkt is en de PR 7.1c-schrijfpad
//      uitsluitend `projectGameForCloud()`-afgeleide payloads schrijft; de
//      PR 7.1a-converter blijft fail-closed bij het lezen.
//
// Nieuw in PR 7.2a — afgeronde wedstrijden synchroniseren (docs/pr-7.2-plan.md §C 7.2a):
//  14. `games/{gameId}` krijgt een nieuw veld `completedGameId` (nullable string):
//      `null` totdat de wedstrijd is afgerond, daarna `CompletedGame.id`. Bewust
//      GEEN `phase: 'completed'` — `phase` spiegelt exact `ActiveGame.phase`
//      (`'setup'|'tracking'`, nooit `'completed'`), zie `firebase/src/documents/
//      game.ts`. Zodra `completedGameId` gezet is, is het parentdocument
//      bevroren: het normale patchpad (punt 10a hierboven) eist nu ook
//      `resource.data.completedGameId == null` en laat `completedGameId` zelf
//      ongewijzigd — een afgeronde wedstrijd accepteert geen draaiveldpatches
//      meer.
//  15. Nieuw update-pad (10c): de eenmalige "finalize-patch" die
//      `completedGameId` van `null` naar een niet-lege string zet — uitsluitend
//      de ACTUELE writer, alleen als nog niet eerder afgerond, en raakt verder
//      niets dan `completedGameId`/`revision`/`updatedAt` (dezelfde
//      optimistische-concurrencycontrole als punt 10a/10b: `revision` moet
//      exact met 1 omhoog).
//  16. Nieuwe collectie `completedGames/{completedGameId}`, zusje van `games`
//      onder hetzelfde team (zie `firebase/src/documents/completedGame.ts`):
//      create-only en daarna
//      volledig onveranderlijk (`allow update, delete: if false` — PR 7.2c
//      voegt pas een tombstone-pad toe). Create vereist `canWriteGameData` +
//      volledige schema-/typevalidatie (`isValidCompletedGamePayload`,
//      zelfde `hasAll`+`hasOnly`-patroon als punt 13) + pad-/payloadcontext
//      + dat de aanroeper de ACTUELE writer is van het `sourceGameId`-parent-
//      document (`gameData(...).writerUid == request.auth.uid` — spiegelt
//      exact hoe punt 11 een action-envelope aan de huidige claim bindt).
//      Zoals bij `players`/`onCourt` (punt 13) blijft `segments` alleen op
//      `list`-type gecontroleerd, geen element-voor-elementvalidatie.
//  17. Geen recursieve-wildcard match voor `completedGames` (zelfde
//      argumentatie als punt 12 voor `games`/`actions`): nog geen
//      cross-team-querybehoefte, dus elke `collectionGroup`-query blijft
//      default-deny.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function orgMemberPath(orgId) {
      return /databases/$(database)/documents/organizations/$(orgId)/organizationMembers/$(request.auth.uid);
    }

    function isOrgMember(orgId) {
      return signedIn() && exists(orgMemberPath(orgId));
    }

    function orgRole(orgId) {
      return get(orgMemberPath(orgId)).data.role;
    }

    function isOrgOwnerOrAdmin(orgId) {
      return isOrgMember(orgId) && orgRole(orgId) in ['organizationOwner', 'organizationAdmin'];
    }

    function teamMemberPath(orgId, teamId) {
      return /databases/$(database)/documents/organizations/$(orgId)/teams/$(teamId)/teamMembers/$(request.auth.uid);
    }

    function isTeamMember(orgId, teamId) {
      return signedIn() && exists(teamMemberPath(orgId, teamId));
    }

    function teamRole(orgId, teamId) {
      return get(teamMemberPath(orgId, teamId)).data.role;
    }

    function canReadTeam(orgId, teamId) {
      return isOrgMember(orgId) || isTeamMember(orgId, teamId);
    }

    function canManageTeamData(orgId, teamId) {
      return isOrgOwnerOrAdmin(orgId) ||
        (isTeamMember(orgId, teamId) && teamRole(orgId, teamId) == 'coach');
    }

    // PR 7.1b, punt 8: ruimere bevoegdheid dan canManageTeamData — owner/admin/
    // coach/scorer mogen wedstrijddata schrijven, spiegelt
    // v2/src/domain/organizations/teamAccess.ts deriveTeamAccess().canWriteGameData.
    function canWriteGameData(orgId, teamId) {
      return isOrgOwnerOrAdmin(orgId) ||
        (isTeamMember(orgId, teamId) && teamRole(orgId, teamId) in ['coach', 'scorer']);
    }

    function gameRef(orgId, teamId, gameId) {
      return /databases/$(database)/documents/organizations/$(orgId)/teams/$(teamId)/games/$(gameId);
    }

    // Enkel gebruikt binnen action-Rules; Firestore memoiseert herhaalde get()-
    // aanroepen naar hetzelfde document binnen één evaluatie (geen extra leeskosten).
    function gameData(orgId, teamId, gameId) {
      return get(gameRef(orgId, teamId, gameId)).data;
    }

    // Punt 13: vormregel voor client-autoritatieve ISO-tijdstip-strings
    // (`GameDocument.createdAt`/`startedAt`, `GameActionEnvelopeDocument.
    // occurredAt` — spiegelt firebase/src/documents/validation.ts'
    // assertIsoTimestampString()'s vorm, exact wat Date.prototype.
    // toISOString() produceert). Rules kunnen geen kalenderlogica narekenen
    // (bv. 31 februari) — dat blijft de converter-laag's taak bij het lezen.
    function isIsoTimestampShape(value) {
      return value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$');
    }

    // Exacte sleutelset van GameDocument (firebase/src/documents/game.ts).
    function gameKeys() {
      return [
        'organizationId', 'teamId', 'phase', 'players', 'opponent', 'competition',
        'clockDown', 'limitStr', 'onCourt', 'curQuarter', 'beginSec', 'endSec',
        'pendingSwapLineup', 'scoreFor', 'scoreAgainst', 'segmentCount',
        'writerUid', 'deviceId', 'writerEpoch', 'revision', 'createdAt', 'startedAt',
        'completedGameId', 'updatedAt'
      ];
    }

    // Punt 13: volledige schema-/typevalidatie, toegepast op zowel create als
    // de resulterende documentstaat na elke update — een write mag NOOIT een
    // document opleveren dat de PR 7.1a-converter niet meer kan lezen.
    //
    // [Tweede review-opvolging, P1] Rules kunnen NIET itereren over een list
    // (geen `.all()`/`.map()`/lus-constructie in de Firestore-Rules-taal —
    // een bewuste, gedocumenteerde taalgrens, geen omissie). `players`
    // (list van GamePlayer) en `onCourt`/`pendingSwapLineup` (list van
    // roster-ID-strings) kunnen daarom alleen op `list`-type gecontroleerd
    // worden, niet element-voor-element. Dit residuele gat wordt beperkt
    // door twee lagen buiten Rules: (1) schrijftoegang is al beperkt tot
    // canWriteGameData-rollen (owner/admin/coach/scorer), nooit een
    // willekeurige gebruiker; (2) de PR 7.1c-schrijfpad schrijft uitsluitend
    // `projectGameForCloud()`-afgeleide payloads, nooit rechtstreeks
    // gebruikersinvoer. De PR 7.1a-converter blijft de bron van waarheid bij
    // het lezen en faalt fail-closed op elke malformed speler-entry.
    function isValidGamePayload(data) {
      return data.keys().hasAll(gameKeys()) && data.keys().hasOnly(gameKeys()) &&
        data.organizationId is string &&
        data.teamId is string &&
        data.phase in ['setup', 'tracking'] &&
        data.players is list &&
        data.opponent is string &&
        data.competition is string &&
        data.clockDown is bool &&
        data.limitStr is string &&
        data.onCourt is list &&
        data.curQuarter is int &&
        data.beginSec is int &&
        data.endSec is int &&
        (data.pendingSwapLineup == null || data.pendingSwapLineup is list) &&
        data.scoreFor is int &&
        data.scoreAgainst is int &&
        data.segmentCount is int &&
        (data.writerUid == null || data.writerUid is string) &&
        (data.deviceId == null || (data.deviceId is string && data.deviceId.size() > 0)) &&
        data.writerEpoch is int &&
        data.revision is int &&
        data.createdAt is string && isIsoTimestampShape(data.createdAt) &&
        (data.startedAt == null || (data.startedAt is string && isIsoTimestampShape(data.startedAt))) &&
        (data.completedGameId == null ||
          (data.completedGameId is string && data.completedGameId.size() > 0)) &&
        data.updatedAt is timestamp;
    }

    // Exacte sleutelset van GameActionEnvelopeDocument (firebase/src/documents/gameAction.ts).
    function actionKeys() {
      return [
        'organizationId', 'teamId', 'gameId', 'actionId', 'authorUid', 'deviceId',
        'writerEpoch', 'sequence', 'occurredAt', 'schemaVersion', 'action'
      ];
    }

    function isValidScoreTeam(team) {
      return team in ['for', 'against'];
    }

    // Exacte sleutelset + veldtypen van SegmentDocument
    // (firebase/src/documents/gameAction.ts's assertSegment()). Anders dan
    // `players`/`onCourt` hierboven ís dit een volledig, klein, vast aantal
    // top-level velden — dus WEL volledig te valideren zonder lus. `lineup`
    // blijft alleen op `list`-type gecontroleerd (zelfde taalgrens als
    // hierboven — geen element-voor-element-validatie van de rugnummer-ID's).
    function isValidSegment(segment) {
      return segment.keys().hasAll([
          'id', 'quarter', 'beginSec', 'endSec', 'durSec', 'lineup',
          'pf', 'pa', 'classSum', 'allowed', 'over'
        ]) &&
        segment.keys().hasOnly([
          'id', 'quarter', 'beginSec', 'endSec', 'durSec', 'lineup',
          'pf', 'pa', 'classSum', 'allowed', 'over'
        ]) &&
        segment.id is string && segment.id.size() > 0 &&
        segment.quarter is int &&
        segment.beginSec is int &&
        segment.endSec is int &&
        segment.durSec is int &&
        segment.lineup is list &&
        segment.pf is number &&
        segment.pa is number &&
        segment.classSum is number &&
        segment.allowed is number &&
        segment.over is bool;
    }

    // Discriminated union van GameActionPayloadDocument — exacte sleutelset
    // per actietype, spiegelt firebase/src/documents/gameAction.ts's
    // assertActionPayload(). `segment` wordt nu volledig gevalideerd via
    // isValidSegment() (tweede review-opvolging, P1: eerder alleen op
    // `map`-type gecontroleerd, waardoor bijv. `segment: {}` werd
    // geaccepteerd terwijl assertSegment() dat afwijst).
    function isValidActionPayload(action) {
      return (action.type == 'score-delta' &&
          action.keys().hasAll(['type', 'team', 'delta']) && action.keys().hasOnly(['type', 'team', 'delta']) &&
          isValidScoreTeam(action.team) && action.delta is number) ||
        (action.type == 'score-set' &&
          action.keys().hasAll(['type', 'team', 'value']) && action.keys().hasOnly(['type', 'team', 'value']) &&
          isValidScoreTeam(action.team) && action.value is number) ||
        (action.type == 'segment-saved' &&
          action.keys().hasAll(['type', 'segment']) && action.keys().hasOnly(['type', 'segment']) &&
          action.segment is map && isValidSegment(action.segment)) ||
        (action.type == 'segment-edited' &&
          action.keys().hasAll(['type', 'segmentId', 'segment']) &&
          action.keys().hasOnly(['type', 'segmentId', 'segment']) &&
          action.segmentId is string && action.segmentId.size() > 0 &&
          action.segment is map && isValidSegment(action.segment)) ||
        (action.type == 'segment-deleted' &&
          action.keys().hasAll(['type', 'segmentId']) && action.keys().hasOnly(['type', 'segmentId']) &&
          action.segmentId is string && action.segmentId.size() > 0);
    }

    // Punt 13: volledige schema-/typevalidatie voor action-envelopes.
    // `schemaVersion == 1` spiegelt GAME_ACTION_SCHEMA_VERSION (fail-closed op
    // onbekende toekomstige versies, zelfde contract als de converter).
    // `authorUid`/`deviceId` zijn non-empty (spiegelt assertNonEmptyString()
    // in de converter — tweede review-opvolging, P1: een lege deviceId-
    // string werd voorheen alleen als `is string` gecontroleerd).
    function isValidActionEnvelope(data) {
      return data.keys().hasAll(actionKeys()) && data.keys().hasOnly(actionKeys()) &&
        data.organizationId is string &&
        data.teamId is string &&
        data.gameId is string &&
        data.actionId is string &&
        data.authorUid is string && data.authorUid.size() > 0 &&
        data.deviceId is string && data.deviceId.size() > 0 &&
        data.writerEpoch is int &&
        data.sequence is int &&
        data.occurredAt is string && isIsoTimestampShape(data.occurredAt) &&
        data.schemaVersion == 1 &&
        data.action is map && isValidActionPayload(data.action);
    }

    // Exacte sleutelset van CompletedGameDocument (firebase/src/documents/completedGame.ts).
    function completedGameKeys() {
      return [
        'organizationId', 'teamId', 'sourceGameId', 'opponent', 'competition', 'date',
        'players', 'segments', 'scoreFor', 'scoreAgainst', 'quarterCount', 'periodLabel',
        'useClassLimit', 'syncedAt'
      ];
    }

    // PR 7.2a, punt 16: volledige schema-/typevalidatie voor de bevroren
    // completed-snapshot, zelfde `hasAll`+`hasOnly`-patroon als punt 13.
    // `segments`/`players` blijven, net als bij `games` hierboven, alleen op
    // `list`-type gecontroleerd — dezelfde taalgrens (geen lus-/`.all()`-
    // constructie voor element-voor-elementvalidatie).
    function isValidCompletedGamePayload(data) {
      return data.keys().hasAll(completedGameKeys()) && data.keys().hasOnly(completedGameKeys()) &&
        data.organizationId is string &&
        data.teamId is string &&
        data.sourceGameId is string && data.sourceGameId.size() > 0 &&
        data.opponent is string &&
        data.competition is string &&
        data.date is string && isIsoTimestampShape(data.date) &&
        data.players is list &&
        data.segments is list &&
        data.scoreFor is int &&
        data.scoreAgainst is int &&
        data.quarterCount is int &&
        data.periodLabel is string &&
        data.useClassLimit is bool &&
        data.syncedAt is timestamp;
    }

    function invRef(orgId, invId) {
      return /databases/$(database)/documents/organizations/$(orgId)/invitations/$(invId);
    }

    function orgMemberRef(orgId, uid) {
      return /databases/$(database)/documents/organizations/$(orgId)/organizationMembers/$(uid);
    }

    // ---- organizations/{orgId} ----
    match /organizations/{orgId} {
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow read:   if isOrgMember(orgId);
      allow update, delete: if isOrgMember(orgId) && orgRole(orgId) == 'organizationOwner';

      // ---- organizationMembers/{uid} ----
      match /organizationMembers/{uid} {
        // Directe GET's/writes: bestaand gedrag, ongewijzigd. Voor de
        // collectionGroup-LIST-query (issue #28) is een aparte recursieve
        // match verderop in dit bestand nodig — zie de toelichting bovenaan.
        allow read: if isOrgMember(orgId);

        // Bootstrap: maker van de org claimt zijn eigen owner-membership.
        // `uid`-veld verplicht en moet matchen (issue #28 — betrouwbaar queryveld).
        allow create: if signedIn() && request.auth.uid == uid &&
          request.resource.data.role == 'organizationOwner' &&
          request.resource.data.uid == uid &&
          get(/databases/$(database)/documents/organizations/$(orgId)).data.createdBy == request.auth.uid;

        // Join via geaccepteerde uitnodiging — membership-create en accepted → claimed moeten
        // in dezelfde batch zitten. getAfter() maakt overslaan van de claim-stap onmogelijk.
        // `uid`-veld verplicht en moet matchen (issue #28 — betrouwbaar queryveld).
        allow create: if signedIn() && request.auth.uid == uid &&
          request.auth.token.email_verified == true &&
          request.resource.data.uid == uid &&
          request.resource.data.invitationId is string &&
          get(invRef(orgId, request.resource.data.invitationId)).data.status == 'accepted' &&
          get(invRef(orgId, request.resource.data.invitationId)).data.email == request.auth.token.email &&
          get(invRef(orgId, request.resource.data.invitationId)).data.role == request.resource.data.role &&
          getAfter(invRef(orgId, request.resource.data.invitationId)).data.status == 'claimed';

        // Owner verwijdert andermans membership onbeperkt — nooit het eigen document.
        allow delete: if isOrgOwnerOrAdmin(orgId) &&
          orgRole(orgId) == 'organizationOwner' && request.auth.uid != uid;

        // Owner wijzigt andermans membership onbeperkt — nooit het eigen document.
        // `uid`-veld moet bij UPDATE ongewijzigd blijven (== document-ID == huidige
        // waarde): zonder deze eis kan owner/admin per ongeluk of moedwillig het
        // querybepalende veld (issue #28) laten afwijken van de document-ID, waardoor
        // de recursieve collectionGroup-regel (die uitsluitend `resource.data.uid`
        // controleert) dit membership aan de verkeerde gebruiker toont of de echte
        // eigenaar het laat "verdwijnen" uit diens eigen contextwisselaar-query.
        allow update: if isOrgOwnerOrAdmin(orgId) &&
          orgRole(orgId) == 'organizationOwner' && request.auth.uid != uid &&
          request.resource.data.uid == uid && request.resource.data.uid == resource.data.uid;

        // Admin verwijdert andermans membership, maar mag GEEN owner-rol aanraken.
        allow delete: if isOrgOwnerOrAdmin(orgId) &&
          orgRole(orgId) == 'organizationAdmin' && request.auth.uid != uid &&
          resource.data.role != 'organizationOwner';

        // Admin wijzigt andermans membership, maar mag GEEN owner-rol aanraken (instellen
        // of verwijderen); zelfde `uid`-invariant als hierboven bij owner.
        allow update: if isOrgOwnerOrAdmin(orgId) &&
          orgRole(orgId) == 'organizationAdmin' && request.auth.uid != uid &&
          resource.data.role != 'organizationOwner' &&
          request.resource.data.role != 'organizationOwner' &&
          request.resource.data.uid == uid && request.resource.data.uid == resource.data.uid;
      }

      // ---- invitations/{invitationId} ----
      match /invitations/{invitationId} {
        // Owner mag uitnodigingen aanmaken met elke rol; admin mag NIET de owner-rol uitnodigen.
        allow create: if isOrgOwnerOrAdmin(orgId) &&
          request.resource.data.status == 'pending' &&
          request.resource.data.invitedBy == request.auth.uid &&
          (orgRole(orgId) == 'organizationOwner' || request.resource.data.role != 'organizationOwner');

        // Intrekken (owner/admin): alleen statusveld naar 'revoked'.
        allow update: if isOrgOwnerOrAdmin(orgId) &&
          request.resource.data.status == 'revoked' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);

        // Accepteren: geverifieerde e-mail van de uitgenodigde; raakt alleen status + acceptedAt.
        allow update: if signedIn() &&
          request.auth.token.email == resource.data.email &&
          request.auth.token.email_verified == true &&
          resource.data.status == 'pending' &&
          request.resource.data.status == 'accepted' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedAt']);

        // Claimen: de uitgenodigde markeert de uitnodiging als 'claimed' in dezelfde batch waarin
        // het bijbehorende membership ontstaat. exists/getAfter koppelen beide writes atomair.
        allow update: if signedIn() &&
          request.auth.token.email == resource.data.email &&
          request.auth.token.email_verified == true &&
          resource.data.status == 'accepted' &&
          request.resource.data.status == 'claimed' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'claimedAt']) &&
          !exists(orgMemberRef(orgId, request.auth.uid)) &&
          existsAfter(orgMemberRef(orgId, request.auth.uid)) &&
          getAfter(orgMemberRef(orgId, request.auth.uid)).data.invitationId == invitationId &&
          getAfter(orgMemberRef(orgId, request.auth.uid)).data.role == resource.data.role &&
          getAfter(orgMemberRef(orgId, request.auth.uid)).data.email == resource.data.email;

        allow read: if isOrgOwnerOrAdmin(orgId) ||
          (signedIn() && request.auth.token.email == resource.data.email);
      }

      // ---- teams/{teamId} ----
      match /teams/{teamId} {
        // `orgName` verplicht als string (issue #31 — denormalisatie t.b.v. team-only leden,
        // zie toelichting bovenaan); geen verdere correctheidscheck nodig, de aanmaker is al
        // owner/admin van de organisatie zelf en heeft dus toch al volledige controle.
        allow create: if isOrgOwnerOrAdmin(orgId) &&
          request.resource.data.createdBy == request.auth.uid &&
          request.resource.data.orgName is string;
        allow read:   if canReadTeam(orgId, teamId);
        allow update, delete: if isOrgOwnerOrAdmin(orgId);

        match /teamMembers/{uid} {
          // Directe GET's: bestaand gedrag. Voor de collectionGroup-LIST-query (issue #31) is
          // een aparte recursieve match verderop nodig — zie de toelichting bovenaan.
          allow read: if canReadTeam(orgId, teamId);

          // `uid`-veld verplicht en moet matchen (issue #31 — betrouwbaar queryveld, zelfde
          // patroon als organizationMembers/{uid} voor issue #28).
          allow create: if isOrgOwnerOrAdmin(orgId) && request.resource.data.uid == uid;

          // `uid` moet bij UPDATE ongewijzigd blijven — zonder deze eis kan owner/admin het
          // querybepalende veld laten afwijken van de document-ID, met hetzelfde risico als
          // bij organizationMembers hierboven (punt 5).
          allow update: if isOrgOwnerOrAdmin(orgId) &&
            request.resource.data.uid == uid && request.resource.data.uid == resource.data.uid;

          allow delete: if isOrgOwnerOrAdmin(orgId);
        }

        // Één settings-document per team: settings/current.
        match /settings/{settingsId} {
          allow read:  if canReadTeam(orgId, teamId);
          allow write: if settingsId == 'current' && canManageTeamData(orgId, teamId);
        }

        // Één roster-document per team: roster/current (volledige array, zie SPIKE_REPORT.md).
        match /roster/{rosterId} {
          allow read:  if canReadTeam(orgId, teamId);
          allow write: if rosterId == 'current' && canManageTeamData(orgId, teamId);
        }

        // ---- games/{gameId}: PR 7.1a/7.1b — cloudkopie van ActiveGame ----
        match /games/{gameId} {
          allow read: if canReadTeam(orgId, teamId);

          // Punt 9/13: volledig schema/type (isValidGamePayload), pad-/
          // payloadcontext, toegestane initiële fase/revisie/epoch, en
          // "maker" geborgd via het writer-veld (geen apart createdBy-veld).
          // Tweede review-opvolging (P1): writerUid/deviceId moeten SAMEN
          // "beide null" (nog geen claim) of "beide gezet" zijn — een
          // document met writerUid == eigen uid maar deviceId == null kon
          // voorheen ontstaan, en zo'n document kan daarna geen enkele
          // action meer accepteren (die eist een non-empty deviceId die
          // overeenkomt met het parentdocument) én niet meer via het
          // initiële-claim-pad hersteld worden (dat vereist juist
          // writerUid == null).
          allow create: if canWriteGameData(orgId, teamId) &&
            isValidGamePayload(request.resource.data) &&
            request.resource.data.organizationId == orgId &&
            request.resource.data.teamId == teamId &&
            request.resource.data.revision == 0 &&
            request.resource.data.writerEpoch == 0 &&
            request.resource.data.completedGameId == null &&
            ((request.resource.data.writerUid == null && request.resource.data.deviceId == null) ||
              (request.resource.data.writerUid == request.auth.uid &&
                request.resource.data.deviceId is string && request.resource.data.deviceId.size() > 0));

          // Punt 10a: normale patch — uitsluitend de ACTUELE writer, en
          // writer-/epochvelden blijven exact ongewijzigd (geen claim/
          // overname via dit pad). Kernvelden staan niet in de allowlist en
          // zijn dus impliciet onveranderlijk; isValidGamePayload() dwingt
          // bovendien af dat het resulterende document altijd volledig en
          // typegeldig blijft. PR 7.2a, punt 14: geweigerd zodra de wedstrijd
          // al is afgerond (`completedGameId != null`) — een bevroren
          // historie-item accepteert geen draaiveldpatches meer.
          //
          // Punt 15 (PR 7.2a) en punt 10b hieronder — de finalize-patch en de
          // initiële claim — staan bewust in DEZELFDE `allow update`-regel als
          // de normale patch (in plaats van drie losse `allow update`-regels):
          // Firestore Rules evalueert bij een update-request elke matchende
          // `allow update`-regel apart, en `isValidGamePayload()` (~25
          // veldchecks) bleek drie keer per request te duur — de
          // Rules-emulator sloeg om bij "maximum of 1000 expressions to
          // evaluate" zodra alle drie de paden apart stonden (empirisch
          // ontdekt via `tests/rules/completed-games.spec.ts`/
          // `games-and-actions.spec.ts`, aug. 2026). Eén gedeelde
          // `isValidGamePayload()`-aanroep plus een OR van de drie
          // padspecifieke voorwaarden houdt hetzelfde autorisatiecontract
          // aan tegen ongeveer een derde van de evaluatiekosten.
          allow update: if canWriteGameData(orgId, teamId) &&
            isValidGamePayload(request.resource.data) &&
            request.resource.data.organizationId == resource.data.organizationId &&
            request.resource.data.teamId == resource.data.teamId &&
            (
              // 10a: normale patch — uitsluitend de ACTUELE writer, writer-/
              // epochvelden en completedGameId blijven exact ongewijzigd.
              (resource.data.writerUid != null &&
                request.auth.uid == resource.data.writerUid &&
                resource.data.completedGameId == null &&
                request.resource.data.writerUid == resource.data.writerUid &&
                request.resource.data.deviceId == resource.data.deviceId &&
                request.resource.data.writerEpoch == resource.data.writerEpoch &&
                request.resource.data.completedGameId == resource.data.completedGameId &&
                request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                  'phase', 'onCourt', 'curQuarter', 'beginSec', 'endSec',
                  'pendingSwapLineup', 'scoreFor', 'scoreAgainst', 'segmentCount',
                  'revision', 'startedAt', 'updatedAt'
                ]) &&
                (request.resource.data.phase == resource.data.phase ||
                  (resource.data.phase == 'setup' && request.resource.data.phase == 'tracking')) &&
                request.resource.data.revision == resource.data.revision + 1)
              ||
              // Punt 15: eenmalige finalize-patch — uitsluitend de ACTUELE
              // writer, alleen als nog niet eerder afgerond, raakt verder
              // niets dan completedGameId/revision/updatedAt. Geen pad om
              // een eenmaal gezette completedGameId te wijzigen/terugzetten.
              (resource.data.writerUid != null &&
                request.auth.uid == resource.data.writerUid &&
                resource.data.completedGameId == null &&
                request.resource.data.completedGameId is string &&
                request.resource.data.completedGameId.size() > 0 &&
                request.resource.data.writerUid == resource.data.writerUid &&
                request.resource.data.deviceId == resource.data.deviceId &&
                request.resource.data.writerEpoch == resource.data.writerEpoch &&
                request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['completedGameId', 'revision', 'updatedAt']) &&
                request.resource.data.phase == resource.data.phase &&
                request.resource.data.revision == resource.data.revision + 1)
              ||
              // 10b: initiële claim — alleen als het document nog GEEN writer
              // heeft; de aanroeper claimt uitsluitend zichzelf, writerEpoch
              // blijft ongewijzigd. Een latere OVERNAME (bestaande writer
              // vervangen) heeft bewust geen pad hier — dat is PR 7.3-scope
              // (transactioneel, met epoch-increment).
              (resource.data.writerUid == null &&
                resource.data.deviceId == null &&
                request.resource.data.writerUid == request.auth.uid &&
                request.resource.data.deviceId is string && request.resource.data.deviceId.size() > 0 &&
                request.resource.data.writerEpoch == resource.data.writerEpoch &&
                request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['writerUid', 'deviceId', 'revision', 'updatedAt']) &&
                request.resource.data.phase == resource.data.phase &&
                request.resource.data.revision == resource.data.revision + 1)
            );

          allow delete: if false;

          // ---- actions/{actionId}: append-only bronactielog (PR 7.1a/7.1b) ----
          match /actions/{actionId} {
            allow read: if canReadTeam(orgId, teamId);

            // Punt 11/13: create-only, volledig schema/type
            // (isValidActionEnvelope), eigen auteur, overeenkomende pad-/
            // payloadcontext, en writerEpoch/deviceId/writerUid moeten
            // overeenkomen met de ACTUELE claim op het parentdocument.
            allow create: if canWriteGameData(orgId, teamId) &&
              isValidActionEnvelope(request.resource.data) &&
              request.resource.data.organizationId == orgId &&
              request.resource.data.teamId == teamId &&
              request.resource.data.gameId == gameId &&
              request.resource.data.actionId == actionId &&
              request.resource.data.authorUid == request.auth.uid &&
              gameData(orgId, teamId, gameId).writerUid == request.auth.uid &&
              request.resource.data.writerEpoch == gameData(orgId, teamId, gameId).writerEpoch &&
              request.resource.data.deviceId == gameData(orgId, teamId, gameId).deviceId;

            allow update, delete: if false;
          }
        }

        // ---- completedGames/{completedGameId}: PR 7.2a — bevroren snapshot ----
        // van een afgeronde wedstrijd (zusje van games/{gameId}, geen
        // subcollectie — zie firebase/src/documents/completedGame.ts en punt
        // 16 hierboven).
        match /completedGames/{completedGameId} {
          allow read: if canReadTeam(orgId, teamId);

          // Create-only, volledig schema/type (isValidCompletedGamePayload),
          // pad-/payloadcontext, en de aanroeper moet de ACTUELE writer zijn
          // van het sourceGameId-parentdocument — spiegelt exact hoe punt 11
          // een action-envelope aan de huidige claim bindt.
          allow create: if canWriteGameData(orgId, teamId) &&
            isValidCompletedGamePayload(request.resource.data) &&
            request.resource.data.organizationId == orgId &&
            request.resource.data.teamId == teamId &&
            gameData(orgId, teamId, request.resource.data.sourceGameId).writerUid == request.auth.uid;

          // Onveranderlijk en onverwijderbaar in fase 7 (docs/pr-7.2-plan.md
          // §B/§D) — een tombstone-fieldpatch is bewust PR 7.2c-scope.
          allow update, delete: if false;
        }
      }
    }

    // ---- issue #28: querycontract contextwisselaar ----
    // Recursieve-wildcard match, uitsluitend om de ENE toegestane
    // collectionGroup-query mogelijk te maken (zie firebase/docs/QUERY_CONTRACT.md):
    //   collectionGroup('organizationMembers').where('uid','==',eigenUid)
    // Bewust de smalst mogelijke voorwaarde: geen get()/exists(), puur
    // resource.data vergeleken met request.auth.uid — dat is precies wat
    // Firestore voor een collectionGroup-LIST-query vooraf kan bewijzen.
    // Dit governeert UITSLUITEND leestoegang tot het eigen membershipdocument
    // via een collectionGroup-query; alle overige toegang (collega's binnen
    // dezelfde org lezen, create/update/delete) loopt via de geneste match
    // hierboven en is hier niet herhaald.
    match /{path=**}/organizationMembers/{uid} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // ---- issue #31: querycontract "mijn teams zonder organisatiemembership" ----
    // Analoog aan issue #28 hierboven, nu voor teamMembers: de enige toegestane
    // collectionGroup-query is
    //   collectionGroup('teamMembers').where('uid','==',eigenUid)
    // Zelfde smalst mogelijke voorwaarde: geen get()/exists(), puur resource.data
    // vergeleken met request.auth.uid. Governeert uitsluitend leestoegang tot het
    // eigen teamMembers-document via een collectionGroup-query; alle overige
    // toegang loopt via de geneste match hierboven en is hier niet herhaald.
    match /{path=**}/teamMembers/{uid} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
    }
  }
}
